+/* All FE/HUD objects retain the original logical 640x480 coordinates,
+ * including cached drag gauges and post-race menus. Fit both UI submitters
+ * per draw, using semantic edge anchors for HUD elements and a centered
+ * canvas for menus. World views/composites retain the full render target. */
+static float nfsu1_fe_canvas(const VSConst *vsk, const VSProg *prog){
+    extern int nfsu1_widescreen_active(void);
+    if (!nfsu1_widescreen_active() ||
+        !g_com_cpu || !g_bb_w || !g_bb_h) return 0.f;
+    /* com_call has already popped the guest return address into eip. */
+    uint32_t caller = g_com_cpu->eip;
+    if (caller != 0x0040C2D6u && caller != 0x0040C4A8u) return 0.f;
+    if (prog){
+        int cw = -1, cx = vs_pos_creg(prog, &cw), cy = vs_pos_creg_y(prog);
+        if (cx < 0 || cx > 120 || cy < 0 || cy > 120 || cw < 0 || cw > 120)
+            return 0.f;
+        const float *w = vsk->f[cw];
+        if (fabsf(w[0]) + fabsf(w[1]) + fabsf(w[2]) > 1e-6f ||
+            fabsf(w[3] - 1.f) > 1e-6f) return 0.f;
+    }
+    /* Keep every glyph/quad in a cached FE element on the same edge.
+     * The viewport is chosen by the page from this frame's target size. */
+    extern float nfsu1_widescreen_ui_canvas(CPU *);
+    return nfsu1_widescreen_ui_canvas(g_com_cpu);
+}
