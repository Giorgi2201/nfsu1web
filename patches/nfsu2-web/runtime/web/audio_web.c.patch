+/* Static effects may intentionally repeat forever. Only a non-static buffer
+ * rewritten in partial regions while playing is treated as a stream. Keep
+ * cursor motion independent of freshness: the guest writer follows it. */
+void audio_buffer_static(int id, int is_static){
+    if (id <= 0 || id >= MAXSND) return;
+    pthread_mutex_lock(&g_slock);
+    g_snd[id].is_static = is_static;
+    pthread_mutex_unlock(&g_slock);
+}
+void audio_note_region(int id, uint32_t offset, uint32_t bytes){
+    if (id <= 0 || id >= MAXSND) return;
+    pthread_mutex_lock(&g_slock);
+    SndBuf *b = &g_snd[id];
+    uint32_t bpf = b->chans * (b->bits / 8u);
+    if (b->used && bpf && bytes && offset < b->bytes && bytes <= b->bytes - offset){
+        uint32_t count = b->bytes / bpf;
+        if (!b->fresh && !b->is_static && b->playing && b->loop && bytes < b->bytes){
+            b->fresh = malloc(count);
+            if (b->fresh) memset(b->fresh, 1, count);
+        }
+        if (b->fresh){
+            uint32_t first = offset / bpf, end = (offset + bytes) / bpf;
+            if (end > first) memset(b->fresh + first, 1, end - first);
+        }
+    }
+    pthread_mutex_unlock(&g_slock);
+}
